PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
DATABASE_URL="file:./dev.db"
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_DAYS=7

# PayPal REST app credentials from the PayPal Developer Dashboard.
# Use sandbox while testing; switch PAYPAL_BASE_URL to https://api-m.paypal.com for live payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD

# Create the first administrator with `npm run admin:create`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisAdminPassword123!
